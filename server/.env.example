# Cadena de conexión de tu base de datos en Neon (neon.tech).
# La sacas de: tu proyecto en Neon > Connection string (elige "Pooled connection").
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require. 

# Cualquier texto largo y secreto, para firmar la sesión de login.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Puerto donde corre el servidor.
PORT=3000

# Solo se usa en desarrollo local, para permitir que el cliente (Vite,
# puerto 5173) le hable al servidor desde otro origen.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
